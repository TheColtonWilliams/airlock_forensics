#cloud-config
# AIRLOCK autoinstall for the Ubuntu 24.04 live-server ISO. Packer serves this file through
# templatefile() (packer/ubuntu-24.04.pkr.hcl): each dollar-brace placeholder is filled from
# packer/variables.pkr.hcl, and a doubled dollar sign stands for a literal one.
# Tasks 1.2, 1.3, 2B.9, 2B.17, 6.1.
# Tests: tests/unit/test_packer_user_data.py (here), tests/goss/base.yaml (in the booted image).
autoinstall:
  version: 1
  interactive-sections: []
  refresh-installer:
    update: false
  locale: en_US.UTF-8
  keyboard:
    layout: us
  timezone: Etc/UTC
  source:
    id: ubuntu-server-minimal
    search_drivers: false
  # Hardware neutral: no vendor drivers, codecs, or OEM kernels picked from the build VM.
  drivers:
    install: false
  codecs:
    install: false
  oem:
    install: false
  updates: all
  # Network is used during the build only. The finished image has no network path; the
  # finalize step removes this netplan file and the harden_network role masks networking.
  network:
    version: 2
    ethernets:
      build-nic:
        match:
          name: "en*"
        dhcp4: true
  # Task 6.1: every package comes from one dated snapshot.ubuntu.com mirror.
  apt:
    preserve_sources_list: false
    geoip: false
    fallback: abort
    primary:
      - arches: [default]
        uri: "${apt_mirror}"
    security:
      - arches: [default]
        uri: "${apt_security_mirror}"
  # Tasks 1.3 and 1.12: generic-flavour HWE kernel, never linux-virtual.
  kernel:
    package: "${kernel_package}"
  # Packer needs SSH during the build. The finalize step purges openssh-server, so the
  # published image has no SSH server.
  ssh:
    install-server: true
    allow-pw: false
  # Tasks 2B.9 and 2B.17: drive layout from docs/dev/contract.md section 3.
  # BIOSBOOT, EFI, ASSETS, OUTPUT, then the ext4 root last so it can grow on first boot.
  # Curtin cannot make exFAT, so ASSETS and OUTPUT are left unformatted here; the base role
  # names them, sets their type to Microsoft basic data, and runs mkfs.exfat.
  # No swap partition, no swap file, no LVM.
  storage:
    swap:
      size: 0
    config:
      - id: disk0
        type: disk
        match:
          size: largest
        ptable: gpt
        wipe: superblock-recursive
        preserve: false
        grub_device: false
      - id: part-biosboot
        type: partition
        device: disk0
        number: 1
        size: 1M
        flag: bios_grub
        preserve: false
      - id: part-esp
        type: partition
        device: disk0
        number: 2
        size: ${esp_size_mib}M
        flag: boot
        grub_device: true
        preserve: false
      - id: part-assets
        type: partition
        device: disk0
        number: 3
        size: ${assets_partition_gib}G
        preserve: false
      - id: part-output
        type: partition
        device: disk0
        number: 4
        size: ${output_partition_gib}G
        preserve: false
      - id: part-root
        type: partition
        device: disk0
        number: 5
        size: -1
        preserve: false
      - id: fs-esp
        type: format
        volume: part-esp
        fstype: fat32
        label: EFI
        preserve: false
      - id: fs-root
        type: format
        volume: part-root
        fstype: ext4
        label: AIRLOCK_ROOT
        preserve: false
      - id: mount-root
        type: mount
        device: fs-root
        path: /
      - id: mount-esp
        type: mount
        device: fs-esp
        path: /boot/efi
  # Task 1.2: the analyst account has a locked password (no password exists) and no SSH key.
  # Autologin, passwordless sudo, and screen-lock-off come from the base role.
  # The build user exists only for Packer; the finalize step deletes it and disables cloud-init.
  user-data:
    disable_root: true
    ssh_pwauth: false
    users:
      - name: "${airlock_user}"
        gecos: AIRLOCK analyst
        shell: /bin/bash
        lock_passwd: true
      - name: "${build_user}"
        gecos: AIRLOCK build access, removed at the end of the build
        shell: /bin/bash
        lock_passwd: true
        sudo: "ALL=(ALL) NOPASSWD:ALL"
        ssh_authorized_keys:
          - "${build_ssh_public_key}"
  late-commands:
    # Task 1.3: drop any virtual-flavour kernel; it lacks the drivers real PCs need.
    - >-
      curtin in-target -- sh -c 'for p in linux-virtual linux-image-virtual linux-headers-virtual
      linux-virtual-hwe-24.04 linux-image-virtual-hwe-24.04 linux-kvm linux-image-kvm;
      do if dpkg -s "$p" >/dev/null 2>&1; then apt-get -y purge "$p" || exit 1; fi; done'
    # Task 1.3: initramfs carries most modules, so the drive boots on hardware other than the build VM.
    - printf 'MODULES=most\n' > /target/etc/initramfs-tools/conf.d/airlock-modules.conf
    - curtin in-target -- update-initramfs -u -k all
  shutdown: reboot
